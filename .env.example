# Environment variable names.

PF_TOKEN_ENDPOINT=https://pingfederate.example.com/as/token.oauth2
PF_CLIENT_ID=replace-me
PF_CLIENT_SECRET=replace-me
PF_SUBJECT_TOKEN_TYPE=urn:ietf:params:oauth:token-type:access_token
PF_REQUESTED_TOKEN_TYPE=urn:ietf:params:oauth:token-type:access_token
PF_CLIENT_AUTH_METHOD=client_secret_basic
PF_AUDIENCE_PARAMETER=resource
PF_VERIFY_SSL=true
PF_SCOPE_PREFIX_TO_STRIP=
PF_REQUEST_TIMEOUT_SECONDS=10
PF_ENABLE_ACTOR_TOKEN=false
PF_ACTOR_CLIENT_ID=
PF_ACTOR_CLIENT_SECRET=
PF_ACTOR_SCOPES=

# Optional example runtime settings.
MCP_SERVER_CONFIG=examples/mcp_servers.yaml
STRANDS_SYSTEM_PROMPT=
